# Copy to .env.local and fill in values. Never commit real values.

# Supabase (local: printed by `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# LLM (Phase 2+). Server-only.
LLM_PROVIDER=
LLM_SCREENING_MODEL=
LLM_ANALYSIS_MODEL=
OPENAI_API_KEY=

# Firecrawl (Phase 3+). Server-only.
FIRECRAWL_API_KEY=
