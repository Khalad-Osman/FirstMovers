# Copy to .env.local and fill in values. Never commit real values.

# Supabase (local: printed by `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SECRET_KEY=

# LLM (Phase 2+). Server-only.
LLM_PROVIDER=
LLM_SCREENING_MODEL=
LLM_ANALYSIS_MODEL=
OPENAI_API_KEY=

# Firecrawl (Phase 3+). Server-only.
FIRECRAWL_API_KEY=

# Discovery background steps (random string, 16+ characters). Server-only.
DISCOVERY_JOB_SECRET=

# Vercel Cron secret for /api/cron/daily (16+ characters). Server-only.
CRON_SECRET=

# Public sign-up (true locally; false on the hosted app, where admins create accounts).
SIGNUP_ENABLED=

# Email notifications (optional; off until all are set). Server-only.
# EMAIL_PROVIDER=resend, EMAIL_FROM is a verified sender such as "First Movers <alerts@your-domain>".
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=
# Base URL for links in emails (defaults to the Vercel production URL).
APP_URL=
